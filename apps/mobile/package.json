{
  "name": "gtfc-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Application terrain des agents collecteurs — plateforme de taxes locales GTFC",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "verifier": "expo-doctor && expo install --check",
    "build:apk": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "test:schema": "node outils/verifier-schema.js",
    "test": "node --test $(find tests -name '*.test.js')",
    "test:syntaxe": "node outils/verifier-syntaxe.js",
    "test:photos": "node --experimental-sqlite outils/epreuve-file-photos.js",
    "verifier:tout": "npm run test:syntaxe && npm run test:schema && npm run test:photos"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.20",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-battery": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-location": "~57.0.16",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/parser": "^7.29.8",
    "sql.js": "^1.14.1"
  }
}
