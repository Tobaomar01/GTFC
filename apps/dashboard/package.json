{
  "name": "gtfc-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Tableau de bord de la mairie — plateforme de collecte des taxes locales GTFC",
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev -p 3000",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start -p 3000 -H 127.0.0.1",
    "lint": "cd ../.. && npx eslint@9 --config eslint.defauts.mjs apps/dashboard/src",
    "test": "playwright test",
    "test:props": "node outils/verifier-props.js",
    "verifier": "npm run test:props && npm run lint"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "espree": "^10.4.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17"
  },
  "_commentaire_telemetrie": "NEXT_TELEMETRY_DISABLED=1 partout : la plateforme est auto-hebergee, aucun appel sortant hormis les tuiles OpenStreetMap et Wave.",
  "overrides": {
    "postcss": "^8.5.26"
  }
}
