###############################################################################
# Plateforme de collecte des taxes locales — GTFC (Sénégal)
# Fichier de configuration d'environnement
#
# USAGE :
#   cp .env.template .env
#   nano .env          <-- remplir TOUTES les valeurs marquées "A_REMPLIR"
#   chmod 600 .env
#
# NE JAMAIS committer le fichier .env (il est déjà dans .gitignore)
# Générer un secret solide :  openssl rand -base64 48
###############################################################################

# -----------------------------------------------------------------------------
# 1. GÉNÉRAL
# -----------------------------------------------------------------------------
NODE_ENV=production
TZ=Africa/Dakar

# Domaine racine de la plateforme (sans http://, sans slash final)
# Le super-admin sera sur ce domaine, chaque commune sur un sous-domaine :
#   plateforme.sn         -> super-admin
#   gtfc.plateforme.sn    -> commune pilote GTFC
APP_DOMAIN=A_REMPLIR.sn

# Email utilisé par Let's Encrypt pour les alertes d'expiration de certificat
LETSENCRYPT_EMAIL=A_REMPLIR@example.com

# Mettre à 1 UNIQUEMENT pour tester l'obtention des certificats sans consommer
# le quota Let's Encrypt (5 échecs/heure). Remettre à 0 pour la production.
LETSENCRYPT_STAGING=0

# -----------------------------------------------------------------------------
# 2. BASE DE DONNÉES — PostgreSQL 16 + PostGIS
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gtfc_taxes
DB_USER=gtfc_app
DB_PASSWORD=A_REMPLIR_MOT_DE_PASSE_FORT

# Superutilisateur du conteneur PostgreSQL (migrations, extensions, backups)
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=A_REMPLIR_AUTRE_MOT_DE_PASSE_FORT

# Port exposé sur l'hôte. Laisser 127.0.0.1 : la base ne doit JAMAIS être
# accessible depuis Internet.
DB_BIND_ADDRESS=127.0.0.1

# Réglages mémoire PostgreSQL — à ajuster selon la RAM du Mini PC
# (valeurs par défaut calibrées pour 16 Go de RAM)
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=1GB
PG_MAX_CONNECTIONS=200

# -----------------------------------------------------------------------------
# 3. STOCKAGE PHOTOS — MinIO (S3 auto-hébergé)
# -----------------------------------------------------------------------------
# Endpoint interne utilisé par l'API Node.js (ne sort jamais du serveur)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false

# Identifiants racine MinIO (= admin). Minimum 8 caractères pour la clé,
# 8 pour le secret ; viser 20+ en production.
MINIO_ROOT_USER=A_REMPLIR_admin_minio
MINIO_ROOT_PASSWORD=A_REMPLIR_MOT_DE_PASSE_FORT

# Identifiants applicatifs (droits restreints aux buckets de la plateforme).
# Créés automatiquement au démarrage par le service minio-init.
MINIO_ACCESS_KEY=A_REMPLIR_cle_app_minio
MINIO_SECRET_KEY=A_REMPLIR_SECRET_APP_MINIO

# Buckets créés automatiquement
MINIO_BUCKET_PHOTOS=gtfc-photos
MINIO_BUCKET_DOCUMENTS=gtfc-documents
MINIO_BUCKET_QRCODES=gtfc-qrcodes

# Ports exposés sur l'hôte (Nginx fait le reverse proxy en HTTPS)
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# 4. API NODE.JS  (Phase 3)
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1

# Secret de signature des JWT — obligatoire, 48 octets minimum
# openssl rand -base64 48
JWT_SECRET=A_REMPLIR_SECRET_JWT_48_OCTETS_MINIMUM
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Origines autorisées pour le dashboard web (séparées par des virgules)
CORS_ORIGINS=https://A_REMPLIR.sn,https://gtfc.A_REMPLIR.sn

# -----------------------------------------------------------------------------
# 5. DASHBOARD WEB NEXT.JS  (Phase 6)
# -----------------------------------------------------------------------------
DASHBOARD_PORT=3000
DASHBOARD_HOST=127.0.0.1
NEXT_PUBLIC_API_URL=https://api.A_REMPLIR.sn

# -----------------------------------------------------------------------------
# 6. PAIEMENT WAVE SÉNÉGAL
# -----------------------------------------------------------------------------
# Compte Wave Business : https://wave.com/business
# IMPORTANT : Wave ne reçoit QUE le numéro de téléphone et le montant.
# Aucune donnée fiscale ou personnelle ne doit transiter par Wave.
WAVE_API_BASE_URL=https://api.wave.com
WAVE_CURRENCY=XOF
# sandbox | production
WAVE_ENVIRONMENT=sandbox

# --- Tant que vous n'avez PAS de compte Wave Business ------------------------
# Laissez WAVE_API_KEY vide : la plateforme fabrique les liens de paiement
# localement et vous confirmez les paiements avec :
#     cd apps/api && node scripts/simuler-wave.js liste
#     node scripts/simuler-wave.js payer <session>
# Toute la chaîne — avis, encaissement, quittance PDF, carte, statistiques —
# fonctionne exactement comme en production. Seul l'appel réseau à Wave manque.
WAVE_API_KEY=
WAVE_ACTIF=false
# Laisser vide : déduit automatiquement de WAVE_API_KEY (vide = simulation)
WAVE_SIMULER=

# --- Une fois la clé sandbox obtenue -----------------------------------------
#   WAVE_API_KEY=wave_sn_sandbox_XXXXXXXX
#   WAVE_ACTIF=true
#   WAVE_SIMULER=false

# Secret de signature des webhooks. Obligatoire DÈS MAINTENANT, même en
# simulation : c'est lui qui empêche n'importe qui de déclarer un paiement.
# openssl rand -base64 32
WAVE_WEBHOOK_SECRET=A_REMPLIR_SECRET_WEBHOOK_WAVE

# URL publique à déclarer dans le tableau de bord Wave
WAVE_WEBHOOK_URL=https://api.A_REMPLIR.sn/webhooks/wave

# Durée de validité d'un lien de paiement, en heures
WAVE_LIEN_DUREE_H=72

# -----------------------------------------------------------------------------
# 6 bis. ENVOI DE SMS  (aucun opérateur raccordé à ce jour)
# -----------------------------------------------------------------------------
# Sans fournisseur configuré, les demandes de paiement restent en file et sont
# transmises par les agents lors de leur tournée :
#     GET /notifications/a-transmettre
# Pour brancher un opérateur (Orange SMS API, passerelle locale), renseignez
# ces variables et implémentez CANAUX.sms dans
# apps/api/src/services/notification.service.js
#
# DEUX USAGES DISTINCTS, UNE SEULE PASSERELLE :
#   1. les avis de paiement mensuels (notification.service.js) ;
#   2. les CODES A USAGE UNIQUE du portail redevable et de la verification
#      du numero sur le terrain (sms.service.js).
#
# Sans operateur raccorde, le point 1 reste en file et les agents transmettent
# les messages a la main ; le point 2 ecrit le code dans le journal du serveur.
# Toute la chaine fonctionne donc en simulation — seul le dernier maillon
# manque. Le jour ou la cle arrive, aucun code ne change.
#
# CE QUI SORT VERS L'OPERATEUR : un numero et un texte. Jamais un montant,
# jamais un nom, jamais une reference d'avis. sms.service.js REFUSE d'envoyer
# un message contenant l'un de ces elements — la regle est appliquee par le
# code, pas par la discipline.
#
# SMS_FOURNISSEUR : orange | generique
#   orange    = API Orange Developer (Senegal), jeton OAuth2
#   generique = POST JSON { to, from, text } — couvre la plupart des agregateurs
# EN PRODUCTION, SMS_ACTIF=false ARRETE L'API AU DEMARRAGE. Ce n'est pas un
# defaut : sans passerelle, le code a usage unique repartirait EN CLAIR dans la
# reponse HTTP, et connaitre un numero suffirait a ouvrir le dossier fiscal de
# son proprietaire. Le deploiement s'arrete donc a l'etape 7 tant que la valeur
# vaut false.
#
# Deux sorties, et une seule est bonne :
#   1. Raccorder une passerelle : SMS_ACTIF=true + FOURNISSEUR, BASE_URL, API_KEY.
#   2. SMS_SIMULER_EN_PROD=true — EN CONNAISSANCE DE CAUSE, et jamais avec de
#      vrais redevables. Le code s'affiche alors a l'ecran au lieu d'etre envoye.
#      Reserve aux essais sur un serveur qui ne porte aucune donnee reelle.
SMS_ACTIF=false
SMS_SIMULER_EN_PROD=false
SMS_FOURNISSEUR=
SMS_BASE_URL=
SMS_API_KEY=
SMS_EXPEDITEUR=MAIRIE

# -----------------------------------------------------------------------------
# 6 bis. PORTAIL DU REDEVABLE
# -----------------------------------------------------------------------------
# Le commercant consulte son dossier depuis un navigateur, en s'authentifiant
# par code SMS. Le QR code colle sur sa devanture n'ouvre rien : il est
# physiquement accessible a tout passant.
#
# Origines autorisees a appeler /portail — distinctes de CORS_ORIGINS : le
# portail est ouvert au public, le tableau de bord ne l'est pas.
PORTAIL_ORIGINS=
# Mettre a false pour fermer le portail sans toucher au reste de la plateforme.
PORTAIL_ACTIF=true
#
# Les parametres de securite (longueur du code, duree de validite, nombre de
# tentatives, plafond horaire, duree de session) se reglent PAR COMMUNE dans
# app.commune_parametre, avec des bornes imposees par contrainte SQL. Valeurs
# par defaut : 6 chiffres, 5 minutes, 3 tentatives, 5 demandes par heure,
# session de 4 heures.

# -----------------------------------------------------------------------------
# 7. SAUVEGARDES
# -----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/gtfc
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12
# Disque externe monté pour la copie hors-serveur (laisser vide si absent)
BACKUP_MIRROR_DIR=/mnt/backup-externe/gtfc

# -----------------------------------------------------------------------------
# CARTOGRAPHIE — tuiles servies par la commune
# -----------------------------------------------------------------------------
# Les tuiles ne sont JAMAIS chargées depuis un service étranger : la politique
# d'usage d'OpenStreetMap proscrit l'usage systématique, chaque affichage
# révélerait à un tiers où la commune inspecte, et sans lien international la
# carte serait blanche.
#
# Les DONNÉES restent celles d'OpenStreetMap ; ce sont les tuiles qui sont
# générées et servies localement. Une orthophoto par drone y prendra la place
# du fond OSM sans changer de configuration — même URL, autre contenu.
NEXT_PUBLIC_TUILES_URL=/tuiles/{z}/{x}/{y}.png
EXPO_PUBLIC_TUILES_URL=

# ---------------------------------------------------------------------------
# Réglages facultatifs de l'API — valeurs par défaut entre parenthèses.
# Ils étaient lus par le code sans figurer ici : impossibles à découvrir.
# ---------------------------------------------------------------------------
# LOG_LEVEL=info          # (debug hors production) trace|debug|info|warn|error|silent
# LOG_FILE=               # (aucun) chemin d'un journal en plus de la sortie standard
# API_MAX_BODY=1mb        # taille maximale d'une requête
# MINIO_REGION=us-east-1  # région déclarée au client S3
