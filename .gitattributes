# ---------------------------------------------------------------------------
#  Fins de ligne
#
#  Le projet est écrit sous Windows mais s'exécute sous Ubuntu. Un script shell
#  contenant des retours chariot Windows (CRLF) échoue avec le message
#  déroutant « bad interpreter: /usr/bin/env bash^M ». On force donc LF pour
#  tout ce qui est exécuté côté serveur.
# ---------------------------------------------------------------------------

* text=auto eol=lf

*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
*.sql       text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
.env.*      text eol=lf

# Binaires
*.png    binary
*.jpg    binary
*.jpeg   binary
*.pdf    binary
*.apk    binary
*.aab    binary
*.ttf    binary
*.woff2  binary
